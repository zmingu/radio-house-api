# Shared configuration for a local run and for compose. Copy to .env and edit.
#
# Both sides read this same file: compose loads it for the container, and
# rh_env.py loads it for `uvicorn rh_server:app`, so dev and deployment are
# configured identically instead of each machine carrying hand-edited files.
# A real environment variable overrides anything here.

# --- compose only -----------------------------------------------------------
# Host port to publish. Use 127.0.0.1:8002 to keep the (unauthenticated) API off
# the LAN.
HOST_PORT=8002
TZ=Asia/Shanghai

# --- credential pool --------------------------------------------------------
# How many anonymous credentials to bootstrap when credentials.json holds none.
# The site's rate limit is per egress IP and `sticky: credential` gives each
# credential its own IP, so this is what spreads a burst instead of stacking it
# on one address. Only meaningful with the egress proxy on; without it every
# credential leaves from the same IP anyway.
RH_ANON_CREDENTIALS=8

# --- prompt shaping ---------------------------------------------------------
# Upstream input ceiling in estimated tokens. Raise only if 413s stay away.
# RH_PROMPT_TOKEN_BUDGET=28000

# --- egress proxy -----------------------------------------------------------
# These override the matching fields in proxy.json. Leave blank to use the file.
# The token is a secret: keep it in .env or proxy.json, both of which are
# gitignored.
RH_PROXY_ENABLED=
RH_PROXY_URL=
RH_PROXY_TOKEN=
RH_PROXY_PLATFORM=
RH_PROXY_ACCOUNT=
RH_PROXY_STICKY=
RH_PROXY_TRUST_HEADERS=
RH_PROXY_VERIFY_TLS=
